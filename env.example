# .env.example — скопируйте в .env и заполните своими значениями
# cp .env.example .env

# Субдомен вашего магазина (без .retailcrm.ru)
# Пример: если адрес demo.retailcrm.ru — пишите только "demo"
DOMAIN=demo

# API-ключ из RetailCRM → Администрирование → Интеграция → API-ключи
API_KEY=your_api_key_here

# Символьный код сайта из RetailCRM → Администрирование → Сайты
# Если один сайт — обычно "default"
SITE=default
